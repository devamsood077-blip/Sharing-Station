{
  "name": "photobooth-sharing-station",
  "private": true,
  "version": "1.0.8",
  "description": "PhotoboothTO Sharing Station - Modern kiosk for prints, SMS, email & cloud sharing",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && node electron/build.mjs && electron . --dev",
    "start": "electron .",
    "build": "node electron/build.mjs && vite build && electron-builder",
    "build:win": "node electron/build.mjs && vite build && electron-builder --win",
    "build:vite": "vite build",
    "electron:compile": "node electron/build.mjs",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.photoboothto.sharingstation",
    "productName": "Sharing Station",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sharing Station",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "SharingStation-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SharingStation-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "devamsood077-blip",
      "repo": "Sharing-Station"
    }
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.471.1",
    "postmark": "^4.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "twilio": "^5.4.5",
    "uuid": "^11.0.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "form-data": "^4.0.6",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wait-on": "^8.0.1"
  }
}
